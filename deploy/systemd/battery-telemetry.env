# /etc/default/battery-telemetry - flags for battery_telemetry (see --help).
# Broker on the Pi itself:            --host localhost
# Broker on another machine:          --host 192.168.1.50
# Re-anchor SoC after a full charge:  --initial-soc 100
TELEMETRY_ARGS="--host localhost --port 1883 --rate-hz 10 --capacity-mah 2500 --initial-soc 100"
