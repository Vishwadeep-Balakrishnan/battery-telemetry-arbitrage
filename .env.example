# Copy to .env and adjust. Never commit .env.

# --- Backend (FastAPI) ---
# Native: localhost. Inside docker-compose this is overridden to the "db" service.
DATABASE_URL=postgresql+psycopg://battery:battery@localhost:5432/battery
MQTT_ENABLED=true
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC=battery/telemetry
# Comma-separated origins allowed to call the API from a browser, or *
CORS_ORIGINS=*

# --- PostgreSQL (docker-compose) ---
POSTGRES_USER=battery
POSTGRES_PASSWORD=battery
POSTGRES_DB=battery

# --- Arbitrage simulator ---
# Free subscription key from PJM (see README). Leave empty to use the bundled sample.
PJM_API_KEY=
